# The build context is the repository root, and `pnpm install --frozen-lockfile`
# needs every workspace package.json the lockfile lists as an importer. So
# plugins/, packages/ and apps/mcp must NOT be ignored here.
**/node_modules
**/dist
.git
# Anchored at every level, not just the root: pnpm deploy copies a package's
# own .env/.env.local into the runtime bundle, so a local build would bake a
# developer's apps/api/.env secrets into the image.
**/.env
**/.env.*
!.env.example
storage
apps/api/storage
tmp
.claude
.superpowers
.primer
coverage
**/.vitest-tmp
**/.vite
**/*.log
.github
docs
plans
