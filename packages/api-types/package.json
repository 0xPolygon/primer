{
  "name": "@polygonlabs/primer-api-types",
  "version": "0.1.0",
  "description": "Primer REST API wire contract: request/response DTOs, anchor shapes, and their runtime validators.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xPolygon/primer.git",
    "directory": "packages/api-types"
  },
  "homepage": "https://github.com/0xPolygon/primer/tree/master/packages/api-types#readme",
  "bugs": {
    "url": "https://github.com/0xPolygon/primer/issues"
  },
  "license": "MIT",
  "keywords": [
    "primer",
    "polygon",
    "api-types",
    "wire-contract"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "echo 'no tests yet -- guards are tested directly in apps/web/src/companion/protocol.test.ts'",
    "prepublishOnly": "pnpm run build"
  }
}
