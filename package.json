{
  "name": "primer",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "start": "pnpm --filter @primer/api start",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "verify": "pnpm typecheck && pnpm test && pnpm audit --audit-level=high",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres && pnpm db:migrate",
    "db:migrate": "pnpm --filter @primer/api run db:migrate",
    "db:migrate:test": "pnpm --filter @primer/api run db:migrate:test",
    "db:generate": "pnpm --filter @primer/api run db:generate",
    "db:purge": "pnpm --filter @primer/api run db:purge",
    "sync:plugin-versions": "pnpm -r exec node \"$PNPM_SCRIPT_SRC_DIR/scripts/mirror-plugin-version.mjs\"",
    "codegen-drift-check": "pnpm run sync:plugin-versions && git diff --exit-code -- 'plugins/*/.claude-plugin/plugin.json'",
    "ci:version": "changeset version && pnpm run sync:plugin-versions",
    "ci:publish": "pnpm exec changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1"
  }
}
